menu "Sage speaker"

config SAGE_VOICE_HOST
    string "Sage PC IPv4 address"
    default "192.168.1.10"
    help
        Local IPv4 address of the Sage PC, without scheme or port.

config SAGE_VOICE_PORT
    int "Sage voice gateway port"
    range 1 65535
    default 8002

config SAGE_VOICE_SECRET
    string "Sage voice HMAC secret"
    default ""
    help
        Use the same random secret as SAGE_VOICE_SECRET on the Sage PC.

config SAGE_BLE_PRESENCE
    bool "Enable bedroom BLE presence greetings"
    default n
    depends on BT_ENABLED && BT_BLUEDROID_ENABLED && BT_CONTROLLER_ENABLED && BT_BLE_ENABLED
    help
        Scan for the configured Sage BLE beacon and report bedroom sightings to Sage.

config SAGE_BLE_NODE_ID
    string "BLE receiver node ID"
    default "bedroom-speaker"
    depends on SAGE_BLE_PRESENCE

config SAGE_BLE_SERVICE_UUID
    int "BLE beacon service UUID"
    range 61440 65535
    default 65520
    help
        Use the same private 16-bit UUID on the carried beacon and all receivers.

config SAGE_CONFIG_PASSWORD
    string "Speaker setup page password"
    default ""
    help
        Password required to change the Sage server address from the local setup page.

config SAGE_WIFI_SSID
    string "Wi-Fi SSID"
    default ""

config SAGE_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

endmenu
