# Copy this file to ~/.config/sage/llama-fast.env and replace REPLACE_ME paths.
# This is the separate fast-lane server; coding and reasoning share llama.env.
SAGE_LLAMA_CPP_MODEL_PATH=/home/REPLACE_ME/models/sage-fast-local.gguf
SAGE_LLAMA_CPP_SERVER_BIN=/home/REPLACE_ME/llama.cpp/build/bin/llama-server
SAGE_LLAMA_CPP_CACHE_DIR=/home/REPLACE_ME/SAGE/data/kv-cache-fast
SAGE_LLAMA_CPP_HOST=127.0.0.1
SAGE_LLAMA_CPP_PORT=8081
SAGE_LLAMA_CPP_THREADS=6
SAGE_NUM_CTX=16384
