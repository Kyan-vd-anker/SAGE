# Copy this file to ~/.config/sage/llama.env and replace REPLACE_ME paths.
# This file configures the llama.cpp server. Sage's backend is configured
# separately with the systemd override shown in README.md.
SAGE_LLAMA_CPP_MODEL_PATH=/home/REPLACE_ME/models/model.gguf
SAGE_LLAMA_CPP_SERVER_BIN=/home/REPLACE_ME/llama.cpp/build/bin/llama-server
SAGE_LLAMA_CPP_CACHE_DIR=/home/REPLACE_ME/SAGE/data/kv-cache
SAGE_LLAMA_CPP_HOST=127.0.0.1
SAGE_LLAMA_CPP_PORT=8080
SAGE_LLAMA_CPP_THREADS=6
SAGE_NUM_CTX=32768

# If enabling an API key here, also set SAGE_LLAMA_CPP_API_KEY in Sage's
# systemd override so Sage can authenticate to the server.
# SAGE_LLAMA_CPP_API_KEY=
