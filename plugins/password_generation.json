{
  "name": "password_generation",
  "description": "Generate secure random passwords locally. Use whenever the user asks to create, generate or make a password. Optional: length (8-128, default 20), include_symbols, count (1-10).",
  "version": "1.0.0",
  "permission": "safe",
  "sensitive_output": true,
  "keywords": ["passphrase", "random password", "strong password"],
  "input_schema": {
    "type": "object",
    "properties": {
      "length": {"type": "integer", "description": "Characters per password, 8-128 (default 20)"},
      "include_symbols": {"type": "boolean", "description": "Include symbols such as !@#$ (default true)"},
      "count": {"type": "integer", "description": "How many passwords to generate, 1-10 (default 1)"}
    }
  },
  "entrypoint": "password_generation.py:run"
}
